{
  "name": "chat_room_project_assessment",
  "version": "1.0.0",
  "description": "Real-time chat rooms with Node.js, Express and Socket.IO",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "public": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\start-public.ps1",
    "stop:public": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\stop-public.ps1",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:int": "jest tests/integration --runInBand",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logeshps02/chat_room_project_Assessment.git"
  },
  "keywords": [],
  "author": "logeshps02",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/logeshps02/chat_room_project_Assessment/issues"
  },
  "homepage": "https://github.com/logeshps02/chat_room_project_Assessment#readme",
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/unit/**/*.test.js",
      "**/tests/integration/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
